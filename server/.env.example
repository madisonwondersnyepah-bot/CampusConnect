PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
JWT_ACCESS_SECRET="generate-a-long-random-string"
CLIENT_URL="http://localhost:5173"

# Tests use a SEPARATE database (see README). Put this in server/.env.test, never in .env:
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TEST_DBNAME?sslmode=require"